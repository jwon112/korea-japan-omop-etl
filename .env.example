# This file is documentation only. Export the variables in your shell or
# deployment environment; the ETL does not automatically load .env files.
SQLSERVER_SERVER=localhost\SQLEXPRESS
SQLSERVER_WINDOWS_AUTH=1
# SQLSERVER_USERNAME=
# SQLSERVER_PASSWORD=

# New MDF/LDF files are rejected unless both paths are on F:.
SQLSERVER_DATA_DIR=F:\database\data
SQLSERVER_LOG_DIR=F:\database\log
SQLSERVER_FILEGROWTH_MB=4096
VOCAB_FOLDER=C:\path\to\athena-vocabulary

KOREA_RAW_DB=nhisnsc2013original
KOREA_CDM_DB=korea_cohort_cdm_final
KOREA_MAPPING_DB=korea_cohort_cdm_final
KOREA_INITIAL_DATA_MB=153600
KOREA_INITIAL_LOG_MB=51200

JAPAN_RAW_DB=japan_cohort_raw_500k
JAPAN_CDM_DB=japan_cohort_cdm_500k_final
JAPAN_INITIAL_DATA_MB=153600
JAPAN_INITIAL_LOG_MB=51200
